@{
    var site = SiteOpcoes.Value;
    var controller = ViewContext.RouteData.Values["controller"] as string;
    var action = ViewContext.RouteData.Values["action"] as string;
    string Ativo(string c, string? a = null) =>
        controller == c && (a is null || action == a) ? "ativo" : "";
}
<div class="barra-topo">
    <div class="container barra-topo__conteudo">
        <span><i class="fa-solid fa-phone" aria-hidden="true"></i> Central: @site.Telefone</span>
        <a href="@site.WhatsAppLink()" target="_blank" rel="noopener noreferrer">
            <i class="fa-brands fa-whatsapp" aria-hidden="true"></i> WhatsApp
        </a>
        @if (!string.IsNullOrEmpty(site.HelpdeskUrl))
        {
            <a href="@site.HelpdeskUrl" target="_blank" rel="noopener noreferrer">
                <i class="fa-solid fa-headset" aria-hidden="true"></i> Helpdesk
            </a>
        }
    </div>
</div>
<header class="cabecalho">
    <div class="container cabecalho__conteudo">
        <a class="logo" asp-controller="Home" asp-action="Index" aria-label="Laboratório F. Diniz, página inicial">
            <img src="~/img/logo-fdiniz.webp" alt="Laboratório F. Diniz" width="132" height="88">
        </a>
        <button class="menu-botao" type="button" aria-expanded="false" aria-controls="menu-principal">
            <i class="fa-solid fa-bars" aria-hidden="true"></i><span class="sr-only">Abrir menu</span>
        </button>
        <nav id="menu-principal" class="menu" aria-label="Menu principal">
            <a class="@Ativo("Home", "Index")" asp-controller="Home" asp-action="Index">Início</a>
            <a class="@Ativo("Exames")" asp-controller="Exames" asp-action="Index">Catálogo de exames</a>
            <a class="@Ativo("Home", "Unidades")" asp-controller="Home" asp-action="Unidades">Unidades</a>
            <a asp-controller="Home" asp-action="Index" asp-fragment="coleta-domiciliar">Coleta domiciliar</a>
            <a class="@Ativo("Contato")" asp-controller="Contato" asp-action="Index">Contato</a>
            @if (!string.IsNullOrEmpty(site.ResultadosUrl))
            {
                <a class="botao botao--claro menu__resultados" href="@site.ResultadosUrl" target="_blank" rel="noopener noreferrer">
                    <i class="fa-solid fa-file-medical" aria-hidden="true"></i> Resultados
                </a>
            }
        </nav>
    </div>
</header>
