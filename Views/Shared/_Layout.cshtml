@{
    var site = SiteOpcoes.Value;
    var titulo = ViewData["Title"] is string t ? $"{t} | Laboratório F. Diniz" : "Laboratório F. Diniz";
    var descricao = ViewData["Descricao"] as string
        ?? "Laboratório F. Diniz: exames laboratoriais com qualidade e confiança em Campina Grande e região desde 1961.";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@titulo</title>
    <meta name="description" content="@descricao">
    <meta name="theme-color" content="#03113f">
    <link rel="icon" type="image/png" href="~/favicon.png">
    <link rel="stylesheet" href="~/lib/fontawesome/css/fontawesome.min.css">
    <link rel="stylesheet" href="~/lib/fontawesome/css/solid.min.css">
    <link rel="stylesheet" href="~/lib/fontawesome/css/brands.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    <partial name="_Navbar" />
    <main id="conteudo">
        @RenderBody()
    </main>
    <partial name="_Footer" />
    <a class="whatsapp-flutuante" href="@site.WhatsAppLink("Olá! Vim pelo site e gostaria de atendimento.")"
       target="_blank" rel="noopener noreferrer" aria-label="Falar pelo WhatsApp">
        <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
    </a>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
